Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
    Tree Height: 300
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: ugv/map
      Cell Size: 1
      Plane Cell Count: 30
      Color: 160; 160; 164
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: UGV map (live RTAB-Map)
      Enabled: true
      Topic:
        Value: /ugv/cloud_map
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Drone map (live RTAB-Map)
      Enabled: true
      Topic:
        Value: /drone/cloud_map
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: UGV path
      Enabled: true
      Topic:
        Value: /ugv/mapPath
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 235; 104; 52
      Line Style: Billboards
      Line Width: 0.06
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Drone path
      Enabled: true
      Topic:
        Value: /drone/mapPath
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 42; 120; 214
      Line Style: Billboards
      Line Width: 0.06
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: UGV
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /ugv/robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ugv
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Drone
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /drone/robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: drone
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Drone camera
      Enabled: true
      Topic:
        Value: /drone/camera/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: UGV camera
      Enabled: true
      Topic:
        Value: /ugv/camera/color/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 44
    Fixed Frame: ugv/map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: ugv/map
      Focal Point:
        X: 8
        Y: 6.5
        Z: 0
      Distance: 30
      Pitch: 0.8
      Yaw: 3.6
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Drone camera:
    collapsed: false
  UGV camera:
    collapsed: false
  Height: 1000
  Width: 1600
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: false
