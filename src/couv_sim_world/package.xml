<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>couv_sim_world</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic world (canopy_world) for UAV-UGV cooperative RGB-D SLAM: textured floor, walls, a roofed canopy with obstacles above and below, and shared landmarks.</description>
  <maintainer email="kmh9178@inha.edu">eom</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
